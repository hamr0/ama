{
  "manifest_version": 2,
  "name": "AMA",
  "version": "0.1.0",
  "description": "Talk to any website. Not just the page — the whole site.",
  "permissions": ["storage", "activeTab", "<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "browser_action": {
    "default_title": "AMA"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
