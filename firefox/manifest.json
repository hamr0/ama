{
  "manifest_version": 2,
  "name": "ama",
  "version": "1.0.0",
  "description": "Talk to any website. Not just the page — the whole site.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }],
  "sidebar_action": {
    "default_title": "ama",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    },
    "open_at_install": true
  },
  "browser_action": {
    "default_title": "toggle ama sidebar",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ama@extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["technicalAndInteraction"]
      }
    }
  }
}
